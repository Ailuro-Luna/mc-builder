# Public source allowlist. Everything else stays local by default.
/*
!/.gitignore
!/.github/
!/.githooks/
!/README.md
!/AGENT_BUILDING_GUIDE.md
!/CONTRIBUTING.md
!/builder.py
!/rcon.py
!/dimensions.py
!/configure_dimensions.py
!/set_area.py
!/mcp_server.py
!/mc_builder.sc
!/config.example.json
!/test_builder.py
!/test_dimensions.py
!/test_publication.py
!/docs/
!/scripts/
!/plans/

/docs/*
!/docs/PROJECT_STRUCTURE.md
!/docs/MULTI_DIMENSION.md
!/docs/ROADMAP.md
!/docs/PUBLICATION.md
/scripts/*
!/scripts/check_publication.py
/plans/*
!/plans/example-preview-only.json

# Never publish deployment configuration, records, maps, or credentials.
.local/
**/config.json
.env
.env.*
server.properties
*.pem
*.key
*.log
*.lock
*.zip
*.tar.gz
*.bundle
*.mca
level.dat*
__pycache__/
*.py[cod]
.venv/
